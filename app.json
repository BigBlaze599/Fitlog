{
  "expo": {
    "name": "FITLOG",
    "slug": "fitlog-mvp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.fitlog.mvp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F7F5"
      }
    },
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#F4F7F5",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
